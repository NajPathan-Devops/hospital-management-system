  <link rel="stylesheet" href="./../../css/style.css">
</head>
<body>

  <!-- ====================  NAVIGATION ==================== -->
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home">
        <i class="fas fa-hospital-user" aria-hidden="true"></i> Maccare Superspeciality Hospital
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
        aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
            <li class="nav-item"><a class="nav-link" href="/service">Services</a></li>
          <li class="nav-item"><a class="nav-link" href="/home#success">Success Stories</a></li>
          <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
          <li class="nav-item ms-lg-3">
            <a href="/appointment" class="btn btn-appointment"><i class="fas fa-calendar-check me-2"
                aria-hidden="true"></i>Book Appointment</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ====================  PAGE HEADER ==================== -->
  <section class="page-header">
    <div class="container text-center">
      <h1 class="display-4 fw-bold">Book an Appointment</h1>
      <p class="lead col-lg-8 mx-auto">Schedule your consultation with our specialists in just a few steps.</p>
    </div>
  </section>

  <!-- ====================  APPOINTMENT FORM ==================== -->
  <section class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="contact-form-card" id="appointment-form">
          <h3 class="fw-bold mb-4"><i class="fas fa-calendar-check me-2 text-coral" aria-hidden="true"></i>Appointment
            Details</h3>
          <form method="POST" action="/appointment">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="fullName" class="form-label">Full name</label>
                <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Your Name" required>
              </div>
              <div class="col-md-6">
                <label for="phone" class="form-label">Phone number</label>
                <input type="number" class="form-control" id="phone" name="phone" placeholder="+91 98765 43210" required>
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label">Email address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com">
              </div>
              <div class="col-md-6">
                <label for="age" class="form-label">Age</label>
                <input type="number" class="form-control" id="age" name="age" placeholder="Your Age">
              </div>
              <div class="col-md-6">
                <label for="department" class="form-label">Department / speciality</label>
                <select class="form-select" id="department" name="department">
                  <option selected>Select department</option>
                  <option>Joint Replacement</option>
                  <option>Cancer Treatment</option>
                  <option>Diabetology</option>
                  <option>Urology</option>
                  <option>Neurosurgeon</option>
                  <option>Orthopedic Surgeon</option>
                  <option>Cardiologist</option>
                  <option>Oncologist</option>
                </select>
              </div>
              <div class="col-md-6">
                <label for="doctor" class="form-label">Preferred doctor (optional)</label>
                <input type="text" class="form-control" id="doctor" name="doctor" placeholder="Doctor name (if any)">
              </div>
              <div class="col-md-6">
                <label for="date" class="form-label">Preferred date</label>
                <input type="date" class="form-control" id="date" name="date" required>
              </div>
              <div class="col-md-6">
                <label for="time" class="form-label">Preferred time</label>
                <select class="form-select" id="time" name="time">
                  <option selected>Select time slot</option>
                  <option>09:00 am - 11:00 am</option>
                  <option>11:00 am - 01:00 pm</option>
                  <option>02:00 pm - 04:00 pm</option>
                  <option>04:00 pm - 07:00 pm</option>
                </select>
              </div>
              <div class="col-12">
                <label for="reason" class="form-label">Reason for visit / symptoms</label>
                <textarea class="form-control" id="reason" name="reason" rows="4"
                  placeholder="Briefly describe your health concern"></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary btn-custom w-100">
                  Confirm Appointment <i class="fas fa-check-circle ms-2" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================  FOOTER ==================== -->
  <footer class="footer">
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h4 class="text-white"><i class="fas fa-hospital-user me-2" aria-hidden="true"></i>Maccare Hospital</h4>
          <p class="small opacity-75">Evidence based medicine is our motto. Your health is our passion and healing is
            our aim.</p>
        </div>
        <div class="col-md-2 mb-4">
          <h6 class="text-white">Explore</h6>
          <ul class="list-unstyled footer-links">
            <li><a href="/home">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/service">Services</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h6 class="text-white">Our Services</h6>
          <ul class="list-unstyled footer-links">
            <li><a href="/service#joint">Joint Replacement</a></li>
            <li><a href="/service#cancer">Cancer Treatment</a></li>
            <li><a href="/service#heart">Heart Care</a></li>
            <li><a href="/service#brain">Brain Disorders</a></li>
          </ul>
        </div>
        <div class="col-md-3">
          <h6 class="text-white">Connect</h6>
          <div class="d-flex gap-3 fs-4 mb-3">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i><span
                class="visually-hidden">Facebook</span></a>
            <a href="#" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i><span
                class="visually-hidden">Instagram</span></a>
            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin" aria-hidden="true"></i><span
                class="visually-hidden">LinkedIn</span></a>
            <a href="#" aria-label="YouTube"><i class="fab fa-youtube" aria-hidden="true"></i><span
                class="visually-hidden">YouTube</span></a>
          </div>
          <p class="small"><i class="fas fa-phone-alt me-1" aria-hidden="true"></i> +91 241 2422411 </p>
        </div>
      </div>
      <hr class="opacity-25">
      <div class="row">
        <div class="col text-center small opacity-50">© 2026 Maccare Superspeciality Hospital, Ahmednagar. All rights
          reserved.</div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Js start -->
  <script src="./js/js.js"></script>
  <!-- Js end -->
</body>
</html>
