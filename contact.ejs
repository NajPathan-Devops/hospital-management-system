          <li class="nav-item"><a class="nav-link active" href="/contact">Contact</a></li>
          <li class="nav-item ms-lg-3">
            <a href="/appointment" class="btn btn-appointment"><i class="fas fa-calendar-check me-2"
                aria-hidden="true"></i>Book Appointment</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ====================  PAGE HEADER ==================== -->
  <section class="page-header">
    <div class="container text-center">
      <h1 class="display-4 fw-bold">Contact Us</h1>
      <p class="lead col-lg-8 mx-auto">24 Hours / 365 Days open at your service</p>
    </div>
  </section>

  <!-- ====================  CONTACT INFO ==================== -->
  <section class="container py-5">
    <div class="row g-4 mb-5">
      <div class="col-md-4">
        <div class="contact-info-card">
          <div class="contact-icon-large">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
          </div>
          <h4>Our Address</h4>
          <p class="mb-0">Bishop Lloyd Colony, Zopadi Canteen,</p>
          <p>Ahmednagar - 414003, M.S., INDIA</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="contact-info-card">
          <div class="contact-icon-large">
            <i class="fas fa-phone-alt" aria-hidden="true"></i>
          </div>
          <h4>Call Us</h4>
          <p class="mb-1"><strong>+91 241 24224 11</strong></p>
          <p class="mb-1"><strong>+91 241 24224 12</strong></p>
          <p><strong>+91 241 24224 13</strong></p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="contact-info-card">
          <div class="contact-icon-large">
            <i class="fas fa-clock" aria-hidden="true"></i>
          </div>
          <h4>Opening Hours</h4>
          <p class="mb-0"><strong>24 Hours / 365 Days</strong></p>
          <p>Always open at your service</p>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <!-- Contact Form -->
      <div class="col-lg-6">
        <div class="contact-form-card" id="appointment-form">
          <h3 class="fw-bold mb-4">Send us a message</h3>
          <form method="POST" action="/contact">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="name" class="form-label">Full name</label>
                <input type="text" class="form-control" id="name" name="fullName" placeholder="Your Name" required>
              </div>
              <div class="col-md-6">
                <label for="phone" class="form-label">Phone number</label>
                <input type="tel" class="form-control" id="phone" name="phone" placeholder="+91 98765 43210">
              </div>
              <div class="col-12">
                <label for="email" class="form-label">Email address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com">
              </div>
              <div class="col-12">
                <label for="subject" class="form-label">Subject</label>
                <select class="form-select" id="subject" name="subject">
                  <option value="appointment_request" selected>Appointment Request</option>
                  <option value="general_inquiry">General Inquiry</option>
                  <option value="insurance_question">Insurance Question</option>
                  <option value="medical_records">Medical Records</option>
                  <option value="feedback">Feedback</option>
                </select>
              </div>
              <div class="col-12">
                <label for="message" class="form-label">Message</label>
                <textarea class="form-control" id="message" name="message" rows="4" placeholder="How can we help you?"></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary btn-custom w-100">
                  Send Message <i class="fas fa-paper-plane ms-2" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Map -->
      <div class="col-lg-6">
        <div class="map-card">
          <h3 class="fw-bold mb-4">Find us on map</h3>
          <div class="map-container mb-4">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3842.3880542632414!2d74.72960397639837!3d19.11468515690027!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bdcbbd0d90618b3%3A0x79d1390f27ca1e7c!2sMacCare%20Superspeciality%20Hospital!5e0!3m2!1sen!2sin!4v1772707871707!5m2!1sen!2sin"
              width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>

          </div>
          <div class="address-details">
            <p><i class="fas fa-map-pin me-2 text-coral" aria-hidden="true"></i> <strong>Landmark:</strong> Bishop Lloyd
              Colony, Zopadi Canteen, Ahmednagar</p>
            <p><i class="fas fa-train me-2 text-coral" aria-hidden="true"></i> <strong>Nearest Railway Station:</strong>
              Ahmednagar Railway Station (3 km)</p>
            <p><i class="fas fa-bus me-2 text-coral" aria-hidden="true"></i> <strong>Bus Stand:</strong> Ahmednagar ST
              Stand (2.5 km)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================  FOOTER ==================== -->
  <footer class="footer">
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h4 class="text-white"><i class="fas fa-hospital-user me-2" aria-hidden="true"></i>Maccare Hospital</h4>
          <p class="small opacity-75">Evidence based medicine is our motto. Your health is our passion and healing is
            our aim.</p>
        </div>
        <div class="col-md-2 mb-4">
          <h6 class="text-white">Explore</h6>
          <ul class="list-unstyled footer-links">
            <li><a href="/home">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/service">Services</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h6 class="text-white">Our Services</h6>
          <ul class="list-unstyled footer-links">
            <li><a href="/service#joint">Joint Replacement</a></li>
            <li><a href="/service#cancer">Cancer Treatment</a></li>
            <li><a href="/service#heart">Heart Care</a></li>
            <li><a href="/service#brain">Brain Disorders</a></li>
          </ul>
        </div>
        <div class="col-md-3">
          <h6 class="text-white">Connect</h6>
          <div class="d-flex gap-3 fs-4 mb-3">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i><span
                class="visually-hidden">Facebook</span></a>
            <a href="#" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i><span
                class="visually-hidden">Instagram</span></a>
            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin" aria-hidden="true"></i><span
                class="visually-hidden">LinkedIn</span></a>
            <a href="#" aria-label="YouTube"><i class="fab fa-youtube" aria-hidden="true"></i><span
                class="visually-hidden">YouTube</span></a>
          </div>
          <p class="small"><i class="fas fa-phone-alt me-1" aria-hidden="true"></i> +91 241 2422411 </p>
        </div>
      </div>
      <hr class="opacity-25">
      <div class="row">
        <div class="col text-center small opacity-50">© 2026 Maccare Superspeciality Hospital, Ahmednagar. All rights
          reserved.</div>
      </div>
    </div>
  </footer>

