<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Admin Dashboard</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <!-- external style.css -->
  <link rel="stylesheet" href="./../../css/style.css">
  <style>
    .profile-header {
      background: linear-gradient(135deg, #0B2B4F 0%, #1E4A7A 100%);
      color: white;
      padding: 2rem;
      border-radius: 0;
    }

    .profile-avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(232, 180, 188, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      border: 4px solid white;
      margin-bottom: 1rem;
      color: white;
    }

    .activity-timeline {
      position: relative;
      padding-left: 30px;
    }

    .activity-item {
      position: relative;
      padding-bottom: 1.5rem;
    }

    .activity-item::before {
      content: '';
      position: absolute;
      left: -30px;
      top: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #C96E8B;
      border: 3px solid white;
    }

    .activity-item:not(:last-child)::after {
      content: '';
      position: absolute;
      left: -25px;
      top: 20px;
      width: 2px;
      height: calc(100% + 10px);
      background: rgba(201, 110, 139, 0.2);
    }

    .stat-card {
      text-align: center;
      padding: 1.5rem 1rem;
      border-radius: 8px;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px -10px rgba(11, 43, 79, 0.25);
    }

    .stat-card h4 {
      margin-top: 0.5rem;
      font-weight: 600;
      color: #0B2B4F;
    }

    .badge-custom {
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-weight: 500;
      font-size: 0.85rem;
      background: #C96E8B !important;
      color: white !important;
    }

    .card {
      border: none;
      box-shadow: 0 12px 28px -10px rgba(11, 43, 79, 0.12);
    }

    .card-header {
      border-bottom: 1px solid rgba(201, 110, 139, 0.2);
    }

    .btn-primary {
      background: #0B2B4F;
      border-color: #0B2B4F;
    }

    .btn-primary:hover {
      background: #1E4A7A;
      border-color: #1E4A7A;
    }

    .btn-outline-primary {
      color: #C96E8B;
      border-color: #C96E8B;
    }

    .btn-outline-primary:hover {
      background: #C96E8B;
      border-color: #C96E8B;
      color: white;
    }
  </style>
</head>

<body>

  <!-- ====================  ADMIN NAVIGATION ==================== -->
  <nav class="navbar navbar-expand-lg sticky-top bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand text-white" href="/admin/dashboard">
        <i class="fas fa-hospital-user me-2" aria-hidden="true"></i> Admin Panel
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAdmin" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarAdmin">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
          <li class="nav-item">
            <a href="#" class="nav-link text-white"><i class="fas fa-bell me-2"></i>Notifications</a>
          </li>
          <li class="nav-item">
            <a href="/admin/profile" class="nav-link text-white"><i class="fas fa-user me-2"></i>Profile</a>
          </li>
          <li class="nav-item">
            <a href="/admin" class="btn btn-outline-light ms-3">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
        <div class="position-sticky pt-3">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="/admin/dashboard">
                <i class="fas fa-tachometer-alt me-2"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/patients">
                <i class="fas fa-users me-2"></i> Patients
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/appointments">
                <i class="fas fa-calendar-check me-2"></i> Appointments
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/doctors">
                <i class="fas fa-user-md me-2"></i> Doctors
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/services">
                <i class="fas fa-cogs me-2"></i> Services
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/reports">
                <i class="fas fa-chart-bar me-2"></i> Reports
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/settings">
                <i class="fas fa-cog me-2"></i> Settings
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Main content -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <!-- Profile Header -->
        <div class="profile-header">
          <div class="row align-items-center">
            <div class="col-md-3 text-center">
              <div class="profile-avatar">
                <i class="fas fa-user"></i>
              </div>
            </div>
            <div class="col-md-9">
              <h1 class="mb-1">Dr. Sarah Anderson</h1>
              <p class="mb-2"><span class="badge badge-custom bg-light text-dark">Admin</span></p>
              <p class="mb-1"><i class="fas fa-envelope me-2"></i>sarah.anderson@hopehospital.com</p>
              <p class="mb-0"><i class="fas fa-phone me-2"></i>+1 (555) 987-6543</p>
            </div>
          </div>
        </div>

        <!-- Profile Content -->
        <div class="row my-4">
          <!-- Left Column -->
          <div class="col-lg-8">
            <!-- Personal Information -->
            <div class="card mb-4">
              <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user-circle me-2"></i>Personal Information</h5>
              </div>
              <div class="card-body">
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label text-muted">First Name</label>
                    <p class="form-control-plaintext"><strong>Sarah</strong></p>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label text-muted">Last Name</label>
                    <p class="form-control-plaintext"><strong>Anderson</strong></p>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label text-muted">Email</label>
                    <p class="form-control-plaintext"><strong>sarah.anderson@hopehospital.com</strong></p>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label text-muted">Phone</label>
                    <p class="form-control-plaintext"><strong>+1 (555) 987-6543</strong></p>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label text-muted">Date of Birth</label>
                    <p class="form-control-plaintext"><strong>March 15, 1985</strong></p>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label text-muted">Gender</label>
                    <p class="form-control-plaintext"><strong>Female</strong></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col-12">
                    <label class="form-label text-muted">Address</label>
                    <p class="form-control-plaintext"><strong>456 Medical Plaza, Suite 200, Healthcare City, HC 67890</strong></p>
                  </div>
                </div>
                <div class="d-flex gap-2 mt-3 pt-3 border-top">
                  <button type="button" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Edit Profile
                  </button>
                  <button type="button" class="btn btn-outline-secondary">
                    <i class="fas fa-undo me-2"></i>Discard
                  </button>
                </div>
              </div>
            </div>

            <!-- Professional Information -->
            <div class="card mb-4">
              <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-briefcase me-2"></i>Professional Information</h5>
              </div>
              <div class="card-body">
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label text-muted">Position</label>
                    <p class="form-control-plaintext"><strong>Administrator</strong></p>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label text-muted">Department</label>
                    <p class="form-control-plaintext"><strong>Administration</strong></p>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label text-muted">Employee ID</label>
                    <p class="form-control-plaintext"><strong>ADM-001</strong></p>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label text-muted">Join Date</label>
                    <p class="form-control-plaintext"><strong>January 10, 2020</strong></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col-12">
                    <label class="form-label text-muted">Specialization</label>
                    <p class="form-control-plaintext">
                      <span class="badge bg-primary me-2">Hospital Management</span>
                      <span class="badge bg-info me-2">IT Systems</span>
                      <span class="badge bg-success">Staff Coordination</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Account Security -->
            <div class="card">
              <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-lock me-2"></i>Account Security</h5>
              </div>
              <div class="card-body">
                <div class="alert alert-success mb-3">
                  <i class="fas fa-check-circle me-2"></i>
                  Two-Factor Authentication is <strong>Enabled</strong>
                </div>
                <p class="text-muted mb-3">Last password change: <strong>February 20, 2026</strong></p>
                <div class="d-flex gap-2">
                  <button type="button" class="btn btn-warning">
                    <i class="fas fa-key me-2"></i>Change Password
                  </button>
                  <button type="button" class="btn btn-outline-secondary">
                    <i class="fas fa-shield-alt me-2"></i>Manage 2FA
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column -->
          <div class="col-lg-4">
            <!-- Statistics -->
            <div class="card mb-4">
              <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Activity Stats</h5>
              </div>
              <div class="card-body p-0">
                <div class="stat-card bg-light">
                  <i class="fas fa-login text-primary fa-2x"></i>
                  <h4 class="text-primary">127</h4>
                  <small class="text-muted">Total Logins</small>
                </div>
                <div class="stat-card border-top">
                  <i class="fas fa-clock text-warning fa-2x"></i>
                  <h4 class="text-warning">890</h4>
                  <small class="text-muted">Hours Online</small>
                </div>
                <div class="stat-card border-top bg-light">
                  <i class="fas fa-calendar-check text-success fa-2x"></i>
                  <h4 class="text-success">342</h4>
                  <small class="text-muted">Actions Performed</small>
                </div>
              </div>
            </div>

            <!-- Recent Activity -->
            <div class="card">
              <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Activity</h5>
              </div>
              <div class="card-body">
                <div class="activity-timeline">
                  <div class="activity-item">
                    <strong>Logged in</strong>
                    <p class="text-muted mb-0 small">Today at 8:30 AM</p>
                  </div>
                  <div class="activity-item">
                    <strong>Updated 5 appointments</strong>
                    <p class="text-muted mb-0 small">Yesterday at 5:15 PM</p>
                  </div>
                  <div class="activity-item">
                    <strong>Generated reports</strong>
                    <p class="text-muted mb-0 small">March 4, 2026 at 3:45 PM</p>
                  </div>
                  <div class="activity-item">
                    <strong>Added 3 new doctors</strong>
                    <p class="text-muted mb-0 small">March 3, 2026 at 10:20 AM</p>
                  </div>
                  <div class="activity-item">
                    <strong>Changed password</strong>
                    <p class="text-muted mb-0 small">February 20, 2026 at 2:00 PM</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mt-4">
              <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
              </div>
              <div class="card-body d-grid gap-2">
                <button type="button" class="btn btn-outline-primary">
                  <i class="fas fa-download me-2"></i>Download Data
                </button>
                <button type="button" class="btn btn-outline-secondary">
                  <i class="fas fa-bell me-2"></i>Notification Settings
                </button>
                <button type="button" class="btn btn-outline-danger">
                  <i class="fas fa-sign-out-alt me-2"></i>Logout All Sessions
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Js start -->
  <script src="../js/js.js"></script>
  <!-- Js end -->
</body>

</html>